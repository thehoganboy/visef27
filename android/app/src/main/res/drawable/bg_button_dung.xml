<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <item>
        <layer-list>
            <!-- Drop shadow / outer border -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <solid android:color="#30FF3B30" />
                </shape>
            </item>
            <!-- Main liquid red surface with subtle top gloss -->
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="27dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#FF453A"
                        android:centerColor="#E02B20"
                        android:endColor="#C91B11" />
                    <stroke
                        android:width="1dp"
                        android:color="#50FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
