<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- 1. Luồng Camera Preview toàn màn hình -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Lớp phủ Telemetry HUD trực quan tinh gọn -->
    <com.horuseyes.app.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. Thẻ Thông tin Đỉnh Màn hình (Glassmorphic Top HUD Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="#D00F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeColor="#3338BDF8"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <!-- Hàng 1: Tiêu đề App, Trạng thái Hoạt động, Nút Âm thanh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HORUSEYES 2.0"
                    android:textColor="#00E676"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#3300E676"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="● RUNNING"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMute"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🔊 ÂM"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Hàng 2: Chỉ số đo lường hiệu năng & Cự ly -->
            <TextView
                android:id="@+id/tvTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="FPS: -- | Latency: --ms | Cự ly: --cm | TTC: inf"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <!-- Hàng 3: 3 Hành lang quét không gian -->
            <TextView
                android:id="@+id/tvCorridor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="Hành lang: Trái: --cm | Giữa: --cm | Phải: --cm"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Thanh Điều Khiển Nổi Dưới Đáy (Start/Stop, Căn chỉnh) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#E00F172A"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="#3338BDF8"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <!-- Nút START / STOP lớn nổi bật -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="105dp"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#EF4444"
                app:cornerRadius="12dp" />

            <!-- Vạch phân cách -->
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#2E38BDF8" />

            <!-- Cụm Căn chỉnh tiêu cự (Calibration) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CĂN CHỈNH TIÊU CỰ"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Giảm 0.05x -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScaleDown"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="38dp"
                        android:layout_height="36dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#475569" />

                    <!-- Giá trị & Đặt lại 1.00x -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScaleReset"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:minWidth="60dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="1.00x"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <!-- Tăng 0.05x -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScaleUp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="38dp"
                        android:layout_height="36dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#475569" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
