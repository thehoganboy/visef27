<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0C"
    android:fitsSystemWindows="true">

    <!-- Rounded Camera Preview Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cameraCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#20FFFFFF"
        app:cardBackgroundColor="#000000"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.horuseyes.app.ui.OverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="yes"
                android:contentDescription="Perception paused" />

            <!-- Top-Right Manual Flashlight Button (P1-01) -->
            <ImageButton
                android:id="@+id/btnTorch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_torch_button"
                android:src="@drawable/ic_torch"
                android:contentDescription="Bật hoặc tắt đèn pin"
                android:scaleType="centerInside"
                android:elevation="6dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Enlarged Liquid START / STOP Button -->
    <Button
        android:id="@+id/btnStartStop"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_button_chay"
        app:backgroundTint="@null"
        android:text="CHẠY"
        android:contentDescription="Bắt đầu nhận thức tránh va chạm"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#121418"
        android:elevation="4dp"
        android:stateListAnimator="@null" />

</LinearLayout>
