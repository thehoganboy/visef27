{
  "schema_version": "1.2",
  "directive": "FINAL ENGINEERING DIRECTIVE 01B-A++",
  "description": "Standardized Golden Test Cases for Cross-Platform Evaluation (Python, Android Kotlin, iOS Swift)",
  "test_cases": [
    {
      "id": "GOLDEN-01-STATIONARY-CLOSE-30CM",
      "description": "Stationary close obstacle at 30cm (vz = 0 cm/s, TTC = inf). Must trigger CRITICAL proximity alert without suppression.",
      "inputs": {
        "dist_cm": 30.0,
        "velocity_z": 0.0,
        "pan": 0.0,
        "ttc": null,
        "sector_dists": {"LEFT": 100.0, "CENTER": 30.0, "RIGHT": 100.0}
      },
      "expected_outputs": {
        "static_risk": "CRITICAL",
        "dynamic_risk": "NONE",
        "threat_level": "CRITICAL",
        "volume_factor": 1.0,
        "audio_active": true,
        "safe_direction": "NONE"
      }
    },
    {
      "id": "GOLDEN-02-RAPID-APPROACHING-120CM",
      "description": "Rapidly approaching object at 120cm with closing speed 150cm/s (TTC = 0.8s). Must trigger CRITICAL dynamic alert.",
      "inputs": {
        "dist_cm": 120.0,
        "velocity_z": 150.0,
        "pan": 0.0,
        "ttc": 0.80,
        "sector_dists": {"LEFT": 250.0, "CENTER": 120.0, "RIGHT": 250.0}
      },
      "expected_outputs": {
        "static_risk": "WARNING",
        "dynamic_risk": "CRITICAL",
        "threat_level": "CRITICAL",
        "volume_factor": 1.0,
        "audio_active": true,
        "safe_direction": "NONE"
      }
    },
    {
      "id": "GOLDEN-03-CLEAR-PATH-UNVERIFIED",
      "description": "Clear corridor at raw disparity 250 (PCHIP maps to 237.2cm). Must report unverified path and mute audio.",
      "inputs": {
        "dist_cm": 237.2,
        "velocity_z": 0.0,
        "pan": 0.0,
        "ttc": null,
        "sector_dists": {"LEFT": 250.0, "CENTER": 250.0, "RIGHT": 250.0}
      },
      "expected_outputs": {
        "static_risk": "SAFE",
        "dynamic_risk": "NONE",
        "threat_level": "SAFE",
        "audio_active": false,
        "mode_text": "NO_OBSTACLE_DETECTED (Unverified Path)",
        "measurement_basis": "METRIC_ESTIMATED_UNVERIFIED"
      }
    },
    {
      "id": "GOLDEN-04-CONCENTRATED-CORRIDOR-INVALIDITY",
      "description": "Center traversal corridor corrupted with NaN (>20% invalid in center, <10% global). Must report DEGRADED.",
      "inputs": {
        "global_invalid_ratio": 0.08,
        "center_invalid_ratio": 0.60
      },
      "expected_outputs": {
        "is_valid": false,
        "validity_state": "DEGRADED",
        "mode_text_prefix": "VISUAL_EVIDENCE_DEGRADED",
        "center_dist_nan": true
      }
    },
    {
      "id": "GOLDEN-05-PHONE-ROTATION-IMMUNITY",
      "description": "User rotates phone creating pan shift without distance increase. Must NOT attenuate warning volume.",
      "inputs": {
        "dist_cm": 50.0,
        "delta_pan": 0.60,
        "delta_dist": 0.0,
        "velocity_z": 0.0
      },
      "expected_outputs": {
        "is_evading": false,
        "evasion_state": "CAMERA_ROTATION",
        "volume_factor": 1.0,
        "audio_active": true
      }
    },
    {
      "id": "GOLDEN-06-HAZARD-PERSISTENCE-COASTING",
      "description": "Critical obstacle at 35cm exits camera FOV due to camera turn. Must persist CRITICAL warning for up to 0.60 seconds.",
      "inputs": {
        "prior_dist_cm": 35.0,
        "prior_threat_level": "CRITICAL",
        "current_all_obs_empty": true,
        "elapsed_seconds": 0.20
      },
      "expected_outputs": {
        "hazard_persistence_active": true,
        "threat_level": "CRITICAL",
        "audio_active": true
      }
    },
    {
      "id": "GOLDEN-07-PERIPHERAL-CORRIDOR-CANDIDATE",
      "description": "Close obstacle at 50cm at peripheral angle (pan = 0.70). Must be treated as CORRIDOR_CANDIDATE within shoulder envelope.",
      "inputs": {
        "dist_cm": 50.0,
        "pan": 0.70,
        "velocity_z": 0.0
      },
      "expected_outputs": {
        "path_risk": "CORRIDOR_CANDIDATE",
        "threat_level": "WARNING",
        "evasion_state": "COLLISION_RISK_UNRESOLVED",
        "volume_factor": 1.0,
        "safe_direction": "NONE"
      }
    },
    {
      "id": "GOLDEN-08-VISUAL-OBSERVABILITY-NEGATIVE-CONTROL",
      "description": "Featureless white wall (luminance std < 10, laplacian var < 15). Must NOT be falsely marked as UNOBSERVABLE.",
      "inputs": {
        "luminance_mean": 180.0,
        "luminance_std": 6.0,
        "laplacian_var": 5.0
      },
      "expected_outputs": {
        "quality_state": "OBSERVABLE",
        "is_valid": true
      }
    },
    {
      "id": "GOLDEN-09-COASTING-EXPIRATION-LOST-UNRESOLVED",
      "description": "Critical obstacle at 35cm loses tracking; after 0.60s coasting expires. Must NOT transition to SAFE. Transitions to LOST_UNRESOLVED.",
      "inputs": {
        "prior_dist_cm": 35.0,
        "prior_threat_level": "CRITICAL",
        "current_all_obs_empty": true,
        "elapsed_seconds": 0.75
      },
      "expected_outputs": {
        "hazard_state": "LOST_UNRESOLVED",
        "threat_level": "UNRESOLVED_HAZARD",
        "guidance_state": "PATH_UNRESOLVED",
        "cue_mode": "CAUTION_REMINDER",
        "volume_factor": 0.35,
        "audio_active": true
      }
    },
    {
      "id": "GOLDEN-10-OBSERVATION-RECOVERY",
      "description": "Hazard recovers visual observation after coasting or lost state. Must transition to OBSERVATION_RECOVERED.",
      "inputs": {
        "prior_hazard_state": "COASTING_HAZARD",
        "current_dist_cm": 35.0,
        "current_all_obs_empty": false
      },
      "expected_outputs": {
        "hazard_state": "OBSERVATION_RECOVERED",
        "threat_level": "CRITICAL",
        "audio_active": true
      }
    },
    {
      "id": "GOLDEN-11-STARTUP-INITIALIZING-UNKNOWN",
      "description": "App starts up on frame 1 without accumulated temporal evidence. Must default to INITIALIZING and UNKNOWN, never asserting verified safety.",
      "inputs": {
        "frame_id": 1,
        "prior_frame": null,
        "all_obs_empty": true
      },
      "expected_outputs": {
        "hazard_state": "INITIALIZING",
        "threat_level": "UNKNOWN",
        "guidance_state": "PATH_UNVERIFIED",
        "audio_active": false
      }
    },
    {
      "id": "GOLDEN-12-CORRIDOR-CLEAR-OBSERVED-LOW-RISK",
      "description": "Corridor free of detected obstacles for >= 3 stabilized frames. Must transition to OBSERVED_LOW_RISK with NO_HAZARD_DETECTED_IN_OBSERVED_REGION, never claiming verified physical clearance.",
      "inputs": {
        "consecutive_clear_frames": 3,
        "is_camera_rotating": false,
        "center_dist_cm": 250.0
      },
      "expected_outputs": {
        "hazard_state": "OBSERVED_LOW_RISK",
        "threat_level": "SAFE",
        "guidance_state": "NO_HAZARD_DETECTED_IN_OBSERVED_REGION",
        "audio_active": false
      }
    },
    {
      "id": "GOLDEN-13-FPS-INDEPENDENT-REMINDER-STANDBY",
      "description": "Lost hazard caution reminder active for 1.5s real time, then silences to STANDBY_UNRESOLVED to preserve auditory budget while keeping unverified visual state.",
      "inputs": {
        "hazard_state": "LOST_UNRESOLVED",
        "elapsed_unresolved_sec": 1.6,
        "reminder_timeout_sec": 1.5
      },
      "expected_outputs": {
        "hazard_state": "LOST_UNRESOLVED",
        "threat_level": "UNRESOLVED_HAZARD",
        "guidance_state": "PATH_UNRESOLVED",
        "cue_mode": "STANDBY_UNRESOLVED",
        "volume_factor": 0.0,
        "audio_active": false
      }
    }
  ]
}

